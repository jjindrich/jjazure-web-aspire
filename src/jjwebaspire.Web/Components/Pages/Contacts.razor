@page "/contacts"
@rendermode InteractiveServer
@attribute [StreamRendering(true)]

@using jjwebaspire.Web.Data
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations

@inject MyDbContext DbContext

<PageTitle>Contacts</PageTitle>

<h1>Contacts</h1>

@if (contacts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-3 d-flex gap-2 align-items-center">
        <input class="form-control" style="max-width:300px" placeholder="Filter by name or phone..."
               @bind="filterText" @bind:event="oninput" />
        <button class="btn btn-primary" @onclick="ShowAddForm">Add Contact</button>
    </div>

    @if (showForm)
    {
        <div class="card mb-3">
            <div class="card-header">@(isEditing ? "Edit Contact" : "Add Contact")</div>
            <div class="card-body">
                <EditForm Model="formContact" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">First Name</label>
                            <InputText class="form-control" @bind-Value="formContact.FirstName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Last Name</label>
                            <InputText class="form-control" @bind-Value="formContact.LastName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Phone Number</label>
                            <InputText class="form-control" @bind-Value="formContact.PhoneNumber" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success me-2">Save</button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (deleteConfirmId != null)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3">
            <span>Are you sure you want to delete this contact?</span>
            <button class="btn btn-danger btn-sm" @onclick="ConfirmDelete">Delete</button>
            <button class="btn btn-secondary btn-sm" @onclick="() => deleteConfirmId = null">Cancel</button>
        </div>
    }

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th @onclick='() => SetSort("FirstName")' style="cursor:pointer">
                    First Name <span>@SortIndicator("FirstName")</span>
                </th>
                <th @onclick='() => SetSort("LastName")' style="cursor:pointer">
                    Last Name <span>@SortIndicator("LastName")</span>
                </th>
                <th @onclick='() => SetSort("PhoneNumber")' style="cursor:pointer">
                    Phone <span>@SortIndicator("PhoneNumber")</span>
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contact in FilteredAndSortedContacts)
            {
                <tr>
                    <td>@contact.FirstName</td>
                    <td>@contact.LastName</td>
                    <td>@contact.PhoneNumber</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditContact(contact)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(contact.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!FilteredAndSortedContacts.Any())
    {
        <p>No contacts found.</p>
    }
}

@code {
    private List<Contact>? contacts;
    private string filterText = string.Empty;
    private string sortColumn = "LastName";
    private bool sortAscending = true;

    private bool showForm = false;
    private bool isEditing = false;
    private Contact formContact = new();
    private string? editingId;
    private string? deleteConfirmId;

    protected override async Task OnInitializedAsync()
    {
        contacts = await DbContext.Contacts.ToListAsync();
    }

    private IEnumerable<Contact> FilteredAndSortedContacts
    {
        get
        {
            IEnumerable<Contact> result = contacts ?? [];

            if (!string.IsNullOrWhiteSpace(filterText))
            {
                var f = filterText.ToLower();
                result = result.Where(c =>
                    c.FirstName.ToLower().Contains(f) ||
                    c.LastName.ToLower().Contains(f) ||
                    (c.PhoneNumber?.ToLower().Contains(f) ?? false));
            }

            result = sortColumn switch
            {
                "FirstName" => sortAscending ? result.OrderBy(c => c.FirstName) : result.OrderByDescending(c => c.FirstName),
                "LastName" => sortAscending ? result.OrderBy(c => c.LastName) : result.OrderByDescending(c => c.LastName),
                "PhoneNumber" => sortAscending ? result.OrderBy(c => c.PhoneNumber) : result.OrderByDescending(c => c.PhoneNumber),
                _ => result
            };

            return result;
        }
    }

    private string SortIndicator(string column) =>
        sortColumn == column ? (sortAscending ? "▲" : "▼") : string.Empty;

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private void ShowAddForm()
    {
        isEditing = false;
        editingId = null;
        formContact = new Contact();
        showForm = true;
        deleteConfirmId = null;
    }

    private void EditContact(Contact contact)
    {
        isEditing = true;
        editingId = contact.Id;
        formContact = new Contact
        {
            Id = contact.Id,
            FirstName = contact.FirstName,
            LastName = contact.LastName,
            PhoneNumber = contact.PhoneNumber
        };
        showForm = true;
        deleteConfirmId = null;
    }

    private void CancelForm()
    {
        showForm = false;
        isEditing = false;
        editingId = null;
        formContact = new Contact();
    }

    private async Task HandleValidSubmit()
    {
        if (isEditing && editingId != null)
        {
            var existing = contacts?.FirstOrDefault(c => c.Id == editingId);
            if (existing != null)
            {
                existing.FirstName = formContact.FirstName;
                existing.LastName = formContact.LastName;
                existing.PhoneNumber = formContact.PhoneNumber;
                DbContext.Contacts.Update(existing);
            }
        }
        else
        {
            var newContact = new Contact
            {
                Id = Guid.NewGuid().ToString(),
                FirstName = formContact.FirstName,
                LastName = formContact.LastName,
                PhoneNumber = formContact.PhoneNumber
            };
            DbContext.Contacts.Add(newContact);
        }

        await DbContext.SaveChangesAsync();
        contacts = await DbContext.Contacts.ToListAsync();
        CancelForm();
    }

    private void RequestDelete(string id)
    {
        deleteConfirmId = id;
        showForm = false;
    }

    private async Task ConfirmDelete()
    {
        if (deleteConfirmId == null) return;
        var contact = contacts?.FirstOrDefault(c => c.Id == deleteConfirmId);
        if (contact != null)
        {
            DbContext.Contacts.Remove(contact);
            await DbContext.SaveChangesAsync();
            contacts = await DbContext.Contacts.ToListAsync();
        }
        deleteConfirmId = null;
    }
}
